# Copier ce fichier en .env.local et le remplir avec les valeurs du projet Supabase
# (Supabase > Project Settings > API Keys). Voir docs/supabase.md.
# Sans ces valeurs, l'application fonctionne en mode démo local.
NEXT_PUBLIC_SUPABASE_URL=
# Clé « publishable » uniquement : jamais la clé secrète ni service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Adresse publique du site, pour les liens envoyés par e-mail (facultatif en local).
SITE_URL=
# Nombre de proxys de confiance qui AJOUTENT l’IP à X-Forwarded-For (1 par défaut). Voir docs/supabase.md.
TRUSTED_PROXY_HOPS=
